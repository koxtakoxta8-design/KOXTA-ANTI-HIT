--==================================================
-- PANEL MOVIBLE
--==================================================

local Dragging = false
local DragStart
local StartPosition

Title.InputBegan:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		DragStart = Input.Position
		StartPosition = Panel.Position

	end

end)

UserInputService.InputChanged:Connect(function(Input)

	if not Dragging then
		return
	end

	if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

		local Delta = Input.Position - DragStart

		Panel.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)

	end

end)

UserInputService.InputEnded:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = false

	end

end)

--==================================================
-- RUTA DE 5 PUNTOS
--==================================================

local function DoRoute(Character)

	if not Enabled then
		return
	end

	if not Character or not Character.Parent then
		return
	end

	for Index, Position in ipairs(Points) do

		if not Enabled then
			Status.Text = "   ○  ROUTE STOPPED"
			Status.TextColor3 = Color3.fromRGB(255,60,60)
			return
		end

		Status.Text = "   [TP] POINT "..Index.."/5"
		Status.TextColor3 = Color3.fromRGB(255,255,255)

		Character:PivotTo(CFrame.new(Position))

		if Index < #Points then
			RunService.Heartbeat:Wait()
		end

	end

	Status.Text = "   [OK] ROUTE COMPLETE"
	Status.TextColor3 = Color3.fromRGB(0,255,100)

end

--==================================================
-- PROXIMITY PROMPT
--==================================================

ProximityPromptService.PromptTriggered:Connect(function(Prompt, WhoTriggered)

	if WhoTriggered ~= Player then
		return
	end

	if not Enabled or Busy then
		return
	end

	local Character = Player.Character
	if not Character then
		return
	end

	Busy = true
	DoRoute(Character)
	Busy = false

end)

